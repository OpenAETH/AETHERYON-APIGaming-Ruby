# --- Núcleo ---
APP_ENV=development                 # development | production
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aetheryon   # Neon: usar la cadena *pooled* (host con -pooler) + ?sslmode=require
# DATABASE_URL_UNPOOLED=            # opcional: conexión directa de Neon, la usa `bundle exec rake migrate`
# DB_SCHEMA=                        # opcional: schema dedicado (por defecto "public")
# DATA_DIR=./data                   # caché del catálogo de Steam (en Vercel: /tmp/aetheryon, es el default)
# --- Pipeline editorial (Groq). Sin GROQ_API_KEY el pipeline queda deshabilitado (la API de noticias sigue igual) ---
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile   # verificar disponibilidad en console.groq.com
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_TEMPERATURE=0.2
# GROQ_MAX_TOKENS=1200
# GROQ_TIMEOUT=45
# GROQ_CONCURRENCY=2                   # solicitudes simultáneas
# GROQ_MAX_RPM=30                      # tope de solicitudes por minuto (0 = sin tope)
# GROQ_MAX_RETRIES=3                   # reintentos HTTP (429/5xx/timeouts) con backoff y retry-after
# EDITORIAL_WORKER_ENABLED=true        # worker residente (false por defecto en serverless: usar /api/cron/process)
# EDITORIAL_MAX_ATTEMPTS=3             # intentos por noticia antes de pasar a failed
# EDITORIAL_BATCH_SIZE=5
# EDITORIAL_INTERVAL_S=60
# EDITORIAL_INTAKE_HOURS=48            # ventana de trending/latest que se encola
# EDITORIAL_TRENDING_LIMIT=20
# EDITORIAL_LATEST_LIMIT=50
# EDITORIAL_LEASE_MIN=10               # un ítem "processing" más viejo se devuelve a la cola
# CRON_SECRET=                      # protege /api/cron/* (Authorization: Bearer). Vercel lo envía solo si la defines en el proyecto
# SOURCE_TIMEOUT=90                 # segundos por fuente (25 por defecto en serverless)
# STALE_RUN_MIN=20                  # minutos tras los que una recolección "running" se da por caída (6 en serverless)
# SERVERLESS=false                  # true (o VERCEL definida): sin scheduler ni migración/limpieza al arrancar
ADMIN_API_KEY=                      # protege POST/PATCH/DELETE (header X-API-Key). Obligatoria en production.
USER_AGENT=AETHERYON-GamingNewsAPI/1.0
CORS_ORIGINS=                       # lista separada por comas; vacío = sin CORS

# --- Recolección programada ---
SCHEDULER_ENABLED=true
COLLECT_INTERVAL_MIN=15             # cada cuántos minutos el scheduler evalúa qué fuentes tocan
RSS_MIN_INTERVAL_MIN=30
STEAM_MIN_INTERVAL_MIN=60
STEAM_NEWS_COUNT=10
STEAM_MAX_GAMES_PER_RUN=50

# --- NewsMesh (verificar https://newsmesh.co/docs y /pricing) ---
NEWSMESH_API_KEY=
NEWSMESH_PLAN=free                  # free | commercial. En production exige "commercial".
NEWSMESH_BASE_URL=https://api.newsmesh.co/v1
NEWSMESH_ENDPOINT=/search
NEWSMESH_QUERY_PARAM=q
NEWSMESH_LIMIT_PARAM=limit
NEWSMESH_AUTH_MODE=query            # query | header
NEWSMESH_AUTH_NAME=apiKey
NEWSMESH_QUERIES=video games,gaming industry
NEWSMESH_PER_REQUEST=10
NEWSMESH_DAILY_LIMIT=25
NEWSMESH_QUOTA_RESERVE=3
NEWSMESH_MIN_INTERVAL_MIN=240
